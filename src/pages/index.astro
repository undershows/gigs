    <!-- FILTRO ESTADO + BUSCA -->
    <script>
      (function () {
        const input = document.getElementById("search");

        function norm(str) {
          return (str || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .trim();
        }

        // Atualiza o botão "Adicionar ao Google Calendar" e o link do .ics
        // pro estado atualmente selecionado.
        function atualizarLinksCalendario(currentState) {
          const gcalLink = document.getElementById("gcal-link");
          const icsUrlInput = document.getElementById("ics-url");
          if (!gcalLink || !icsUrlInput) return;

          const icsUrl = `${window.location.origin}/calendar/${currentState}.ics`;
          const webcalUrl = icsUrl.replace(/^https?:/, "webcal:");

          gcalLink.href =
            "https://calendar.google.com/calendar/render?cid=" +
            encodeURIComponent(webcalUrl);

          document.querySelectorAll(".state-label").forEach((el) => {
            el.textContent = currentState;
          });

          icsUrlInput.value = icsUrl;
        }

        function aplicarFiltroPorEstado() {
          const params = new URLSearchParams(window.location.search);
          const currentState = params.get("state") || "SP";
          let visible = 0;

          document.querySelectorAll(".show-card").forEach((card) => {
            const uf = card.getAttribute("data-state");

            if (!currentState || uf === currentState) {
              card.style.display = "";
              visible++;
            } else {
              card.style.display = "none";
            }
          });

          const noShows = document.getElementById("no-shows");
          if (noShows) {
            noShows.textContent = "No momento não temos shows cadastrados nesse estado. 😔🎸";
            noShows.style.display = visible === 0 ? "" : "none";
          }

          atualizarLinksCalendario(currentState);
        }

        input.addEventListener("input", function () {
          const term = norm(this.value);
          const noShows = document.getElementById("no-shows");

          if (term === "") {
            aplicarFiltroPorEstado();
            return;
          }

          let visible = 0;

          document.querySelectorAll(".show-card").forEach((card) => {
            const title = norm(card.querySelector(".show-title")?.textContent);
            const info = norm(card.querySelector(".show-info")?.textContent);
            const bands = norm(card.dataset.bands);

            const matches =
              title.includes(term) ||
              info.includes(term) ||
              bands.includes(term);

            if (matches) {
              card.style.display = "";
              visible++;
            } else {
              card.style.display = "none";
            }
          });

          if (noShows) {
            noShows.textContent = "Nenhum show encontrado para essa busca. 😔🎸";
            noShows.style.display = visible === 0 ? "" : "none";
          }
        });

        // Botão "Copiar link" do feed .ics — copia pro clipboard e mostra
        // uma animação de sucesso em vez de um alert().
        const icsUrlInput = document.getElementById("ics-url");
        const icsCopyBtn = document.getElementById("ics-copy-btn");
        let icsCopyTimeout;

        if (icsUrlInput) {
          icsUrlInput.addEventListener("click", function () {
            this.select();
          });
          icsUrlInput.addEventListener("focus", function () {
            this.select();
          });
        }

        if (icsCopyBtn && icsUrlInput) {
          icsCopyBtn.addEventListener("click", async function () {
            const url = icsUrlInput.value;
            if (!url) return;

            try {
              if (navigator.clipboard) {
                await navigator.clipboard.writeText(url);
              } else {
                icsUrlInput.select();
                document.execCommand("copy");
              }
            } catch (err) {
              console.error("Erro ao copiar link do calendário", err);
              icsUrlInput.select();
              return;
            }

            icsCopyBtn.classList.add("copied");
            clearTimeout(icsCopyTimeout);
            icsCopyTimeout = setTimeout(function () {
              icsCopyBtn.classList.remove("copied");
            }, 1800);
          });
        }

        aplicarFiltroPorEstado();
      })();
    </script>

    <!-- COMPARTILHAR -->
    <script>
      (function () {
        const SITE_URL = "https://shows.undershows.com.br";

        async function shareShowFromButton(btn) {
          const title = btn.dataset.title;
          const date = btn.dataset.date;
          const city = btn.dataset.city;
          const state = btn.dataset.state;
          const shareUrl = btn.dataset.shareUrl || SITE_URL;

          const text =
`${title}
${date} - ${city}/${state}

via Undershows: ${shareUrl}`;

          try {
            if (navigator.share) {
              await navigator.share({ text });
            } else if (navigator.clipboard) {
              const fullText =
`${title}
${date} - ${city}/${state}

Cartaz: ${shareUrl}

via Undershows: ${SITE_URL}`;

              await navigator.clipboard.writeText(fullText);
              alert("Link copiado! Cole no WhatsApp/Instagram 🤘");
            } else {
              alert("Copie e cole:\n\n" + text + "\n\nCartaz: " + shareUrl);
            }
          } catch (err) {
            console.error("Erro ao compartilhar", err);
          }
        }

        document.addEventListener("click", function (ev) {
          const btn = ev.target.closest("[data-share-show]");
          if (!btn) return;
          ev.preventDefault();
          shareShowFromButton(btn);
        });
      })();
    </script>

    <!-- AVISOS DE SHOWS (Web Push via FCM) -->
    <script>
      (function () {
        const VAPID_KEY =
          "BLSTasErFJnimal8uqI7If1IhkEKjQMVwnYqp3yanywm03g7RZZH9VNil4Q7Ecup1DcWDuFDIIPPsNJtQVJn48M";
        const FIREBASE_CONFIG = {
          apiKey: "AIzaSyBYg3i2JhINM6Q14T1-qPdjj5TQNwcfKzI",
          authDomain: "undershows.firebaseapp.com",
          projectId: "undershows",
          storageBucket: "undershows.firebasestorage.app",
          messagingSenderId: "432774323974",
          appId: "1:432774323974:web:c3dd042aaf2172b3bf8887",
        };
        const FCM_ENDPOINT = "https://cms.undershows.com.br/api/fcm-tokens";
        const SW_SCOPE = "/firebase-cloud-messaging-push-scope";
        const REFRESH_KEY = "notif_last_refresh";
        const REFRESH_MS = 7 * 24 * 60 * 60 * 1000; // 7 dias

        const box = document.getElementById("notif-optin");
        const btn = document.getElementById("notif-btn");
        const hint = document.getElementById("notif-hint");
        if (!box || !btn) return;

        function showHint(msg) {
          hint.textContent = msg;
          hint.hidden = false;
        }

        const pushSupported =
          "serviceWorker" in navigator &&
          "Notification" in window &&
          "PushManager" in window;
        const isIOS = /iP(hone|ad|od)/.test(navigator.userAgent);
        const isStandalone =
          window.navigator.standalone === true ||
          window.matchMedia("(display-mode: standalone)").matches;

        // Carrega um script (UMD) sob demanda, uma vez.
        function loadScript(src) {
          return new Promise(function (resolve, reject) {
            if (document.querySelector('script[data-fb="' + src + '"]')) return resolve();
            const s = document.createElement("script");
            s.src = src;
            s.async = true;
            s.dataset.fb = src;
            s.onload = resolve;
            s.onerror = function () {
              reject(new Error("falha ao carregar " + src));
            };
            document.head.appendChild(s);
          });
        }

        // Carrega o Firebase (compat, self-hostado) sob demanda, pega o token e cadastra no CMS.
        async function obterECadastrarToken() {
          const registration = await navigator.serviceWorker.register(
            "/firebase-messaging-sw.js",
            { scope: SW_SCOPE }
          );
          await loadScript("/vendor/firebase-app-compat.js");
          await loadScript("/vendor/firebase-messaging-compat.js");
          if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
          const messaging = firebase.messaging();
          const token = await messaging.getToken({
            vapidKey: VAPID_KEY,
            serviceWorkerRegistration: registration,
          });
          if (!token) throw new Error("token vazio");
          const res = await fetch(FCM_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, platform: "web" }),
          });
          if (!res.ok) throw new Error("cms " + res.status);
          localStorage.setItem(REFRESH_KEY, String(Date.now()));
        }

        // --- Estado inicial: o botão só existe pra quem ainda não decidiu ---
        if (Notification.permission === "granted") {
          box.hidden = true; // já ativado: nada na tela (igual Android)
          // Revalida o token no máximo 1x por semana (FCM pode rotacionar).
          const last = Number(localStorage.getItem(REFRESH_KEY) || 0);
          if (pushSupported && Date.now() - last > REFRESH_MS) {
            obterECadastrarToken().catch((e) =>
              console.error("[push] refresh falhou", e)
            );
          }
          return;
        }
        if (Notification.permission === "denied") {
          box.hidden = true; // recusou antes: não insiste
          return;
        }
        // ainda não decidiu → mostra o botão
        box.hidden = false;

        btn.addEventListener("click", async function () {
          // iPhone só recebe push com a PWA instalada na tela de início.
          if (isIOS && !isStandalone) {
            showHint(
              "No iPhone: toque em Compartilhar → “Adicionar à Tela de Início” e abra o app por ali para ativar."
            );
            return;
          }
          if (!pushSupported) {
            showHint("Seu navegador não suporta notificações push.");
            return;
          }
          btn.disabled = true;
          const original = btn.textContent;
          btn.textContent = "Ativando…";
          try {
            const permission = await Notification.requestPermission();
            if (permission !== "granted") {
              btn.textContent = original;
              btn.disabled = false;
              showHint("Permissão não concedida.");
              return;
            }
            await obterECadastrarToken();
            btn.textContent = "🔔 Avisos ativados";
            showHint("Pronto! Você vai receber os avisos de shows.");
            setTimeout(function () {
              box.hidden = true;
            }, 4000);
          } catch (err) {
            console.error("[push] erro ao ativar", err);
            btn.textContent = original;
            btn.disabled = false;
            showHint("Não deu pra ativar agora. Tente novamente.");
          }
        });
      })();
    </script>

  </body>
</html>